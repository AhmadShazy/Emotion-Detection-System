# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
#
#     cp .env.example .env
#
# .env is gitignored. NEVER commit real key values — not here, not in a comment
# in the source. When deploying, set these as environment variables in the
# hosting platform rather than shipping a .env file in the image.
# ─────────────────────────────────────────────────────────────────────────────


# ── Auth ─────────────────────────────────────────────────────────────────────
# Comma-separated list of accepted API keys. These are values YOU choose; they
# are not issued by any third party. Give each person their own so a single key
# can be revoked without disturbing anyone else.
#
# Generate a strong one:
#     python -c "import secrets; print('hma_' + secrets.token_urlsafe(32))"
#
# Callers send it as an  X-API-Key  header, or as  ?api_key=  for WebSockets
# (browsers cannot set headers on a WebSocket handshake).
#
# LEAVING THIS EMPTY DISABLES AUTHENTICATION COMPLETELY. The server prints a
# loud warning at startup if you do.
API_KEYS=replace-me-with-a-generated-key,and-one-per-teammate


# ── LLM forwarding ───────────────────────────────────────────────────────────
# Where completed emotion payloads are POSTed, i.e. the LLM module's endpoint.
# Fire-and-forget with a 5-second timeout: a slow or broken endpoint never
# blocks or fails the user's request. Leave empty to disable forwarding.
LLM_ENDPOINT_URL=


# ── A note on running locally ────────────────────────────────────────────────
# There is no setting that turns authentication off for local requests, and
# that is on purpose. Set API_KEYS above and give the same key to the UI when it
# asks — running on this machine takes exactly the same path as running on a
# server, so the auth path gets tested rather than skipped.
#
# Leaving API_KEYS empty disables authentication everywhere, which is fine for a
# throwaway local demo and printed as a loud warning at startup.
